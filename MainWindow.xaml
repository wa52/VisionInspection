<Window x:Class="SpeakerVisionInspection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="视觉检测平台" Height="920" Width="1560"
        WindowStartupLocation="CenterScreen" Closed="Window_Closed"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 顶部工具栏 -->
            <RowDefinition Height="*" />      <!-- 主区(相机|图像|参数) -->
            <RowDefinition Height="200" />    <!-- 底部面板(结果/日志) -->
            <RowDefinition Height="Auto" />   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ===== 顶部工具栏 ===== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Height="48" LastChildFill="False" Margin="10,0">
                <TextBlock Text="方案" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="RecipeCombo" Width="200" Height="28" VerticalAlignment="Center" IsEditable="True" Margin="0,0,8,0" />
                <Button Content="新建" Height="28" Margin="0,0,6,0" Padding="10,0" VerticalAlignment="Center" Click="RecipeNew_Click" />
                <Button Content="打开" Height="28" Margin="0,0,6,0" Padding="10,0" VerticalAlignment="Center" Click="RecipeOpen_Click" />
                <Button Content="保存" Height="28" Margin="0,0,6,0" Padding="10,0" VerticalAlignment="Center" Click="RecipeSave_Click" />
                <Button Content="另存为" Height="28" Margin="0,0,10,0" Padding="10,0" VerticalAlignment="Center" Click="RecipeSaveAs_Click" />
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="4,10" />

                <Button x:Name="BtnRefreshCamera" Content="刷新相机" Height="28" Margin="6,0,6,0" Padding="10,0" VerticalAlignment="Center" Click="BtnRefreshCamera_Click" />
                <Button x:Name="BtnConnect" Content="连接" Height="28" Margin="0,0,6,0" Padding="14,0" VerticalAlignment="Center" Click="BtnConnect_Click" IsEnabled="False" />
                <Button x:Name="BtnDisconnect" Content="断开" Height="28" Margin="0,0,6,0" Padding="10,0" VerticalAlignment="Center" Click="BtnDisconnect_Click" IsEnabled="False" />
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="4,10" />

                <Button x:Name="BtnStartPreview" Content="预览" Height="28" Margin="6,0,6,0" Padding="10,0" VerticalAlignment="Center" Click="BtnStartPreview_Click" IsEnabled="False" />
                <Button x:Name="BtnStopPreview" Content="停止预览" Height="28" Margin="0,0,6,0" Padding="10,0" VerticalAlignment="Center" Click="BtnStopPreview_Click" IsEnabled="False" />
                <Button x:Name="BtnSoftTrigger" Content="软触发" Height="28" Margin="0,0,6,0" Padding="10,0" VerticalAlignment="Center" Click="BtnSoftTrigger_Click" IsEnabled="False" />
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="4,10" />

                <Button x:Name="BtnRunOnce" Content="单次执行" Height="28" Margin="6,0,6,0" Padding="16,0" VerticalAlignment="Center" FontWeight="Bold"
                        Background="#2E5D36" Foreground="#E0E0E0" BorderBrush="#3D7A47" Click="BtnRunOnce_Click" IsEnabled="False" />
                <Button x:Name="BtnRunContinuous" Content="连续执行" Height="28" Margin="0,0,8,0" Padding="16,0" VerticalAlignment="Center" FontWeight="Bold"
                        Background="#1F4A6E" Foreground="#E0E0E0" BorderBrush="#2F6A9E" Click="BtnRunContinuous_Click" IsEnabled="False" />

                <TextBlock x:Name="FinalVerdictText" Text="待机" FontSize="17" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Border>

        <!-- ===== 主区: 相机 | 图像 | 参数 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- 左: 相机 + 状态 -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" Margin="0,4,0,4">
                <DockPanel>
                    <GroupBox Header="相机列表" DockPanel.Dock="Top" Margin="6">
                        <ListBox x:Name="CameraList" Height="140" Background="Transparent" SelectionChanged="CameraList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                        <TextBlock FontSize="11" Foreground="#888">
                                            <Run Text="{Binding InterfaceType, Mode=OneWay}" /><Run Text=" | " />
                                            <Run Text="{Binding ModelName, Mode=OneWay}" /><Run Text=" | " />
                                            <Run Text="{Binding IpAddress, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </GroupBox>

                    <GroupBox Header="生产状态" DockPanel.Dock="Top" Margin="6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StateDot" Width="12" Height="12" Fill="#888" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="StateText" Text="空闲" VerticalAlignment="Center" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock x:Name="StateDetailText" Text="-" Foreground="#888" Margin="18,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="检测流程" Margin="6">
                        <DockPanel>
                            <Button Content="+ 添加模块" DockPanel.Dock="Top" Height="26" Margin="2,0,2,6" Click="AddNode_Click" />
                            <TreeView x:Name="NodeTree" Background="Transparent" SelectedItemChanged="NodeTree_SelectedItemChanged" MouseDoubleClick="NodeTree_MouseDoubleClick" />
                        </DockPanel>
                    </GroupBox>
                </DockPanel>
            </Border>
            <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}" />

            <!-- 中: 图像区域（节点执行结果，单一面板 + 可开关的节点缩略图条） -->
            <Border Grid.Column="2" Background="#141414" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" Margin="0,4,0,4">
                <DockPanel>
                    <ScrollViewer x:Name="ThumbStripHost" DockPanel.Dock="Bottom" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="116" Background="#101010">
                        <StackPanel x:Name="ThumbStrip" Orientation="Horizontal" Margin="2" />
                    </ScrollViewer>
                    <Grid>
                        <TextBlock x:Name="ResultCaption" Text="执行结果" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        <ToggleButton x:Name="BtnThumbToggle" Content="缩略图" Width="58" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0" FontSize="11" Click="BtnThumbToggle_Click" ToolTip="显示/隐藏各节点图像缩略图条" />
                        <Image x:Name="ResultImage" Stretch="Uniform" Margin="2" />
                        <Canvas x:Name="RoiCanvas" Margin="2" Background="Transparent" IsHitTestVisible="False"
                                MouseLeftButtonDown="RoiCanvas_MouseLeftButtonDown"
                                MouseMove="RoiCanvas_MouseMove"
                                MouseLeftButtonUp="RoiCanvas_MouseLeftButtonUp"
                                MouseRightButtonUp="RoiCanvas_MouseRightButtonUp" />
                    </Grid>
                </DockPanel>
            </Border>
            <Rectangle Grid.Column="3" Fill="{StaticResource BorderBrush}" />

            <!-- 右: 参数 Tab -->
            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" Margin="0,4,0,4">
                <TabControl>
                    <TabItem Header="状态">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="InspectorPanel" Margin="6" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="相机">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <TextBlock Text="曝光时间 (us)" />
                                <TextBox x:Name="ExposureBox" LostFocus="ParameterBox_LostFocus" />
                                <TextBlock Text="增益" Margin="0,8,0,0" />
                                <TextBox x:Name="GainBox" LostFocus="ParameterBox_LostFocus" />
                                <TextBlock x:Name="GainRangeHint" Text="增益范围: 未连接" Foreground="Gray" FontSize="11" />
                                <TextBlock Text="Gamma" Margin="0,8,0,0" />
                                <TextBox x:Name="GammaBox" LostFocus="ParameterBox_LostFocus" />
                                <TextBlock Text="像素格式" Margin="0,8,0,0" />
                                <ComboBox x:Name="PixelFormatBox">
                                    <ComboBoxItem Content="Mono8" />
                                    <ComboBoxItem Content="RGB8" />
                                </ComboBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="触发">
                        <StackPanel Margin="8">
                            <TextBlock Text="触发模式" />
                            <ComboBox x:Name="TriggerModeBox" SelectionChanged="TriggerModeBox_SelectionChanged">
                                <ComboBoxItem Content="连续" />
                                <ComboBoxItem Content="软触发" />
                                <ComboBoxItem Content="硬触发" />
                            </ComboBox>
                            <TextBlock Text="触发源" Margin="0,8,0,0" />
                            <ComboBox x:Name="TriggerSourceBox" IsEnabled="False">
                                <ComboBoxItem Content="Line0" />
                            </ComboBox>
                            <TextBlock Text="触发源固定 Line0（Line1/2 为输出线，不能同时作触发输入）" FontSize="11" Foreground="#888" Margin="0,4,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="触发沿" Margin="0,8,0,0" />
                            <ComboBox x:Name="TriggerEdgeBox">
                                <ComboBoxItem Content="上升沿" />
                                <ComboBoxItem Content="下降沿" />
                            </ComboBox>
                            <TextBlock Text="取图超时 (ms)" Margin="0,8,0,0" />
                            <TextBox x:Name="GrabTimeoutBox" LostFocus="TriggerSettingBox_LostFocus" />
                            <TextBlock Text="最小触发间隔 (ms)" Margin="0,8,0,0" />
                            <TextBox x:Name="TriggerIntervalBox" LostFocus="TriggerSettingBox_LostFocus" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="IO 输出">
                        <StackPanel Margin="8">
                            <TextBlock Text="结果输出" FontWeight="Bold" />
                            <CheckBox x:Name="IoEnabledBox" Content="启用 IO 通信" Margin="0,8,0,0" Checked="IoCommunicationBox_Changed" Unchecked="IoCommunicationBox_Changed" />
                            <TextBlock Text="输出模式" Margin="0,8,0,0" />
                            <ComboBox x:Name="IoOutputModeBox" IsEnabled="False">
                                <ComboBoxItem Content="NG 时输出" />
                            </ComboBox>
                            <TextBlock Text="Strobe 输出线" Margin="0,8,0,0" />
                            <ComboBox x:Name="IoNgOutputLineBox" IsEditable="True">
                                <ComboBoxItem Content="Line1" />
                                <ComboBoxItem Content="Line2" />
                                <ComboBoxItem Content="Line3" />
                            </ComboBox>
                            <TextBlock Text="Strobe 触发源" Margin="0,8,0,0" />
                            <ComboBox x:Name="IoStrobeSourceBox" SelectionChanged="IoCommunicationBox_Changed">
                                <ComboBoxItem Content="FrameTriggerWait" />
                                <ComboBoxItem Content="FrameEndActive" />
                                <ComboBoxItem Content="ExposureEndActive" />
                                <ComboBoxItem Content="TimerActive" />
                            </ComboBox>
                            <TextBlock Text="有效电平" Margin="0,8,0,0" />
                            <ComboBox x:Name="IoActiveLevelBox" SelectionChanged="IoCommunicationBox_Changed">
                                <ComboBoxItem Content="高电平" />
                                <ComboBoxItem Content="低电平" />
                            </ComboBox>
                            <TextBlock Text="脉冲时间 (ms)" Margin="0,8,0,0" />
                            <TextBox x:Name="IoPulseMsBox" LostFocus="IoCommunicationBox_LostFocus" />
                            <Button x:Name="BtnTestNgOutput" Content="测试 NG 输出" Margin="0,12,0,0" Click="BtnTestNgOutput_Click" IsEnabled="False" />
                            <TextBlock x:Name="IoOutputStatusText" Text="状态: 未测试" Foreground="#888" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="说明: OK 时不输出；NG 时输出指定电平脉冲给 PLC。Line0 已作为触发输入，不建议作为输出。" Margin="0,8,0,0" Foreground="#888" TextWrapping="Wrap" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ===== 底部: 结果 + 日志 ===== -->
        <Grid Grid.Row="2" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="检测结果" Margin="2">
                <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding ProcessedAt}" Width="150" />
                        <DataGridTextColumn Header="图片" Binding="{Binding Image}" Width="200" />
                        <DataGridTextColumn Header="判定" Binding="{Binding Decision}" Width="80" />
                        <DataGridTextColumn Header="分数" Binding="{Binding Score}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}" />
            <GroupBox Grid.Column="2" Header="日志" Margin="2">
                <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            </GroupBox>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <StatusBar Grid.Row="3">
            <StatusBarItem><TextBlock x:Name="StatusSdk" Text="SDK: 检查中" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusCamera" Text="相机: 未连接" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusTrigger" Text="触发: -" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusFps" Text="FPS: -" /></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
