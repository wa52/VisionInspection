<Window x:Class="VisionInspection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VisionInspection"
        Title="工业视觉检测平台"
        Height="940" Width="1600" MinWidth="1280" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="ToolBarIconBtn" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style x:Key="ToolBarTextButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style x:Key="ViewportIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style x:Key="StatusChipBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="CmdRecipeNew_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="CmdRecipeOpen_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="CmdRecipeSave_Executed"/>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="CmdUndo_Executed" CanExecute="CmdUndo_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Redo" Executed="CmdRedo_Executed" CanExecute="CmdRedo_CanExecute"/>
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Product header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="4"
                        Background="{StaticResource AccentSoftBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <Grid>
                        <Ellipse Width="16" Height="16" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="2"/>
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="工业视觉检测平台" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="视觉检测与产线质检"
                               Style="{StaticResource EyebrowText}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Menu Grid.Column="2" Height="34" Margin="24,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <MenuItem Header="文件">
                        <MenuItem Header="新建方案" Click="RecipeNew_Click" InputGestureText="Ctrl+N"/>
                        <MenuItem Header="打开方案" Click="RecipeOpen_Click" InputGestureText="Ctrl+O"/>
                        <MenuItem Header="保存方案" Click="RecipeSave_Click" InputGestureText="Ctrl+S"/>
                        <MenuItem Header="方案另存为" Click="RecipeSaveAs_Click"/>
                        <Separator/>
                        <MenuItem Header="退出" Click="MenuExit_Click"/>
                    </MenuItem>
                </Menu>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusChipBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="本地工作站" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusChipBorder}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="模式" Style="{StaticResource EyebrowText}" Margin="0,0,7,0"/>
                            <TextBlock Text="产线" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Command bar -->
        <Border Grid.Row="1" Background="{StaticResource ViewportBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolBarIconBtn}" Click="RecipeNew_Click" ToolTip="新建方案 (Ctrl+N)">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Data="M6,2 L14,2 L20,8 L20,22 L6,22 Z M14,2 L14,8 L20,8 M11,11 L11,19 M7,15 L15,15" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource ToolBarIconBtn}" Click="RecipeOpen_Click" ToolTip="打开方案 (Ctrl+O)">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Data="M2,5 L9,5 L11,7.5 L22,7.5 L22,20 L2,20 Z" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource ToolBarIconBtn}" Click="RecipeSave_Click" ToolTip="保存方案 (Ctrl+S)">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Data="M4,4 L16,4 L20,8 L20,20 L4,20 Z M8,4 L8,9 L16,9 L16,4 M8,20 L8,13 L16,13 L16,20" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button Style="{StaticResource ToolBarIconBtn}" Click="RecipeSaveAs_Click" ToolTip="方案另存为">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Data="M8,2 L15,2 L19,6 L19,11 M5,7 L12,7 L16,11 L16,19 L5,19 Z" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnUndo" Style="{StaticResource ToolBarIconBtn}" Click="BtnUndo_Click" ToolTip="撤销 (Ctrl+Z)" IsEnabled="False">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Data="M8,5 L3,10 L8,15 M3,10 L14,10 C18,10 21,13 21,17 L21,20" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnRedo" Style="{StaticResource ToolBarIconBtn}" Click="BtnRedo_Click" ToolTip="恢复 (Ctrl+Y)" IsEnabled="False">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" Data="M16,5 L21,10 L16,15 M21,10 L10,10 C6,10 3,13 3,17 L3,20" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Height="26" Fill="{StaticResource BorderBrush}" Margin="9,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolBarTextButton}" Click="BtnCameraManager_Click">
                        <TextBlock Text="相机管理"/>
                    </Button>
                    <Button Style="{StaticResource ToolBarTextButton}" Click="BtnCommManager_Click">
                        <TextBlock Text="通信管理"/>
                    </Button>
                </StackPanel>

                <Rectangle Grid.Column="3" Width="1" Height="26" Fill="{StaticResource BorderBrush}" Margin="9,0" VerticalAlignment="Center"/>

                <Grid Grid.Column="4" Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="当前方案" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="选择或编辑检测方案" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="RecipeCombo" Grid.Column="1" Height="34" IsEditable="True" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="BtnLock" Grid.Column="2" Width="34" Height="34" Padding="0" Margin="8,0,0,0"
                                  Click="BtnLock_Click"
                                  ToolTip="锁定方案：ROI 与节点结构不可修改（防误触；参数数值仍可调整）">
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6"
                              Data="M2,4 L22,4 L22,20 L2,20 Z M8,11 L16,11 L16,17 L8,17 Z M10,11 L10,9 A2,2 0 0 1 14,9 L14,11"
                              Width="17" Height="17" Stretch="Uniform"/>
                    </ToggleButton>
                </Grid>

                <Rectangle Grid.Column="5" Width="1" Height="26" Fill="{StaticResource BorderBrush}" Margin="9,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRunOnce" Style="{StaticResource SuccessButton}" Height="36" MinWidth="92" Margin="0,0,6,0"
                            Click="BtnRunOnce_Click" IsEnabled="False" ToolTip="单次执行：执行一遍检测流程">
                        <TextBlock Text="▶  单次检测" Foreground="#166534"/>
                    </Button>
                    <Button x:Name="BtnRunContinuous" Style="{StaticResource PrimaryButton}" Height="36" MinWidth="102" Margin="0,0,10,0"
                            Click="BtnRunContinuous_Click" IsEnabled="False" ToolTip="连续执行：循环执行检测流程（再次点击停止）">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="RunContinuousIcon" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7"
                                  Data="M21,4 L21,10 L15,10 M19.6,15 A8,8 0 1 1 17.7,6.6 L21,10"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,7,0"/>
                            <TextBlock Text="连续执行" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="4" Padding="10,5" MinWidth="96">
                        <StackPanel>
                            <TextBlock Text="最终判定" Style="{StaticResource EyebrowText}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FinalVerdictText"
                                       Text="{Binding FinalDecision, FallbackValue=待机}"
                                       FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Row="2" Margin="10,10,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- Left rail -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="设备与执行状态" Style="{StaticResource EyebrowText}"/>
                                <TextBlock Text="生产状态" Style="{StaticResource SectionTitle}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="状态" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}"/>
                            </Border>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,9,0">
                                <Ellipse x:Name="StateDot" Width="9" Height="9" Fill="{StaticResource SubtleTextBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="StateText" Text="{Binding ProductionState, FallbackValue=空闲}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="当前产线状态" Style="{StaticResource PanelCaption}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="StateDetailText"
                                   Text="{Binding ProductionDetail, FallbackValue=-}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="37,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="流程配置" Style="{StaticResource EyebrowText}"/>
                                <TextBlock Text="检测流程" Style="{StaticResource SectionTitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnAddNode" Grid.Column="1" Style="{StaticResource SoftButton}" Content="+ 添加模块"
                                    Height="30" Padding="10,0" VerticalAlignment="Center" Click="AddNode_Click"/>
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource BorderBrush}"/>
                        <TreeView x:Name="NodeTree" Grid.Row="2" Margin="8" Background="Transparent"
                                  SelectedItemChanged="NodeTree_SelectedItemChanged"
                                  MouseDoubleClick="NodeTree_MouseDoubleClick"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Center viewport -->
            <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Background="{StaticResource ViewportBarBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="视觉检测" Style="{StaticResource EyebrowText}"/>
                                <TextBlock Text="图像检测区" Style="{StaticResource SectionTitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Width="1" Height="25" Background="{StaticResource BorderBrush}" Margin="14,0"/>
                            <TextBlock x:Name="ResultCaption" Text="执行结果" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Button Style="{StaticResource ViewportIconButton}" Click="BtnZoomIn_Click" ToolTip="放大图像">
                                <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.6"
                                      Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21 M10,6 L10,14 M6,10 L14,10"
                                      Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ViewportIconButton}" Click="BtnZoomOut_Click" ToolTip="缩小图像">
                                <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.6"
                                      Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21 M6,10 L14,10"
                                      Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource ViewportIconButton}" Click="BtnImageFit_Click" ToolTip="适应窗口">
                                <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.6"
                                      Data="M3,8 L3,3 L8,3 M16,3 L21,3 L21,8 M21,16 L21,21 L16,21 M8,21 L3,21 L3,16"
                                      Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                            <ToggleButton x:Name="BtnThumbToggle" Width="30" Height="30" Padding="0" Margin="2,0"
                                          Click="BtnThumbToggle_Click" ToolTip="显示/隐藏节点缩略图">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6"
                                      Data="M3,5 L21,5 L21,19 L3,19 Z M6,15 L10,11 L13,14 L16,11 L19,15"
                                      Width="16" Height="16" Stretch="Uniform"/>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ImageViewport" Grid.Row="1" Background="{StaticResource ViewportBrush}" ClipToBounds="True"
                          PreviewMouseWheel="ImageViewport_PreviewMouseWheel"
                          PreviewMouseDown="ImageViewport_PreviewMouseDown"
                          PreviewMouseMove="ImageViewport_PreviewMouseMove"
                          PreviewMouseUp="ImageViewport_PreviewMouseUp">
                        <Image x:Name="ResultImage" Stretch="Uniform" Margin="8" RenderTransformOrigin="0.5,0.5"/>
                        <Canvas x:Name="RoiCanvas" Margin="8" Background="Transparent" IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5"
                                MouseLeftButtonDown="RoiCanvas_MouseLeftButtonDown"
                                MouseMove="RoiCanvas_MouseMove"
                                MouseLeftButtonUp="RoiCanvas_MouseLeftButtonUp"
                                MouseRightButtonUp="RoiCanvas_MouseRightButtonUp"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="8,4"
                                Background="#B30D141D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5"
                                IsHitTestVisible="False">
                            <TextBlock Text="滚轮缩放  ·  拖动画面  ·  ROI 可视化叠加" Foreground="#CBD5E1" FontSize="10"/>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="ThumbStripHost" Grid.Row="2"
                                  Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Height="116"
                                  Background="{StaticResource ViewportBarBrush}"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  BorderThickness="0,1,0,0">
                        <StackPanel x:Name="ThumbStrip" Orientation="Horizontal" Margin="6"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Inspector -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="节点信息" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="节点检查" Style="{StaticResource SectionTitle}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource BorderBrush}"/>
                    <TabControl Grid.Row="2" Margin="12,6,12,12">
                        <TabItem Header="节点状态">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                <StackPanel x:Name="InspectorPanel" Margin="2,4,2,8"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="模块结果">
                            <Grid Margin="2,8,2,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="ModuleResultTitle"
                                           Text="模块结果（在左侧流程选择节点）"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8"/>
                                <local:ModuleResultView x:Name="InspectorResultView" Grid.Row="1"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Evidence / logs -->
        <Grid Grid.Row="3" Margin="10,0,10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="0.92*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="检测记录" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Text="检测记录" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="最近 200 条" Style="{StaticResource PanelCaption}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource BorderBrush}"/>
                    <DataGrid x:Name="ResultGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding ProcessedAt}" Width="150"/>
                            <DataGridTextColumn Header="图片" Binding="{Binding Image}" Width="*"/>
                            <DataGridTextColumn Header="判定" Binding="{Binding Decision}" Width="80"/>
                            <DataGridTextColumn Header="分数" Binding="{Binding Score}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="运行日志" Style="{StaticResource EyebrowText}"/>
                            <TextBlock Text="实时日志" FontWeight="SemiBold" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource OkSoftBrush}" BorderBrush="{StaticResource OkBrush}" BorderThickness="1" CornerRadius="4" Padding="7,3" VerticalAlignment="Center">
                            <TextBlock Text="记录中" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}"/>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource BorderBrush}"/>
                    <TextBox x:Name="LogBox" Grid.Row="2"
                             Style="{StaticResource LogBox}"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock x:Name="StatusCamera" Text="{Binding CameraStatus, FallbackValue=相机: 未连接}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusTrigger" Text="{Binding TriggerStatus, FallbackValue=触发: -}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusFps" Text="{Binding FpsStatus, FallbackValue=FPS: -}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="工业视觉检测平台 · x64 · .NET 8" Foreground="{StaticResource SubtleTextBrush}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>