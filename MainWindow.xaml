<Window x:Class="VisionInspection.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VisionInspection"
        Title="视觉检测平台" Height="920" Width="1560"
        WindowStartupLocation="CenterScreen" Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <!-- 工具栏图标按钮：透明底无边框，悬停/按下由全局按钮模板触发 -->
        <Style x:Key="ToolBarIconBtn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="CmdRecipeNew_Executed" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="CmdRecipeOpen_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="CmdRecipeSave_Executed" />
        <CommandBinding Command="ApplicationCommands.Undo" Executed="CmdUndo_Executed" CanExecute="CmdUndo_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Redo" Executed="CmdRedo_Executed" CanExecute="CmdRedo_CanExecute" />
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 顶栏: 菜单栏 + 工具栏 -->
            <RowDefinition Height="*" />      <!-- 主区(相机|图像|参数) -->
            <RowDefinition Height="200" />    <!-- 底部面板(结果/日志) -->
            <RowDefinition Height="Auto" />   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- ===== 菜单栏（与工具栏分离）===== -->
            <Menu Height="26" VerticalAlignment="Top">
                <MenuItem Header="文件">
                    <MenuItem Header="新建方案" Click="RecipeNew_Click" InputGestureText="Ctrl+N" />
                    <MenuItem Header="打开方案" Click="RecipeOpen_Click" InputGestureText="Ctrl+O" />
                    <MenuItem Header="保存方案" Click="RecipeSave_Click" InputGestureText="Ctrl+S" />
                    <MenuItem Header="方案另存为" Click="RecipeSaveAs_Click" />
                    <Separator />
                    <MenuItem Header="退出" Click="MenuExit_Click" />
                </MenuItem>
            </Menu>

            <!-- ===== 工具栏（图标化，海康式）===== -->
            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Height="42" LastChildFill="False" Margin="8,0">
                    <Button Style="{StaticResource ToolBarIconBtn}" Click="RecipeNew_Click" ToolTip="新建方案 (Ctrl+N)">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M6,2 L14,2 L20,8 L20,22 L6,22 Z M14,2 L14,8 L20,8 M11,11 L11,19 M7,15 L15,15"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolBarIconBtn}" Click="RecipeOpen_Click" ToolTip="打开方案 (Ctrl+O)">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M2,5 L9,5 L11,7.5 L22,7.5 L22,20 L2,20 Z"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolBarIconBtn}" Click="RecipeSave_Click" ToolTip="保存方案 (Ctrl+S)">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M4,4 L16,4 L20,8 L20,20 L4,20 Z M8,4 L8,9 L16,9 L16,4 M8,20 L8,13 L16,13 L16,20"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolBarIconBtn}" Click="RecipeSaveAs_Click" ToolTip="方案另存为">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M8,2 L15,2 L19,6 L19,11 M5,7 L12,7 L16,11 L16,19 L5,19 Z"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="6,10" />
                    <Button x:Name="BtnUndo" Style="{StaticResource ToolBarIconBtn}" Click="BtnUndo_Click" ToolTip="撤销上一步修改 (Ctrl+Z)" IsEnabled="False">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M8,5 L3,10 L8,15 M3,10 L14,10 C18,10 21,13 21,17 L21,20"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="BtnRedo" Style="{StaticResource ToolBarIconBtn}" Click="BtnRedo_Click" ToolTip="恢复下一步修改 (Ctrl+Y)" IsEnabled="False">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M16,5 L21,10 L16,15 M21,10 L10,10 C6,10 3,13 3,17 L3,20"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <ToggleButton x:Name="BtnLock" Width="34" Height="30" Padding="0" Margin="2,0" Click="BtnLock_Click"
                                  ToolTip="锁定方案：ROI 与节点结构不可修改（防误触；参数数值仍可调整）">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M2,4 L22,4 L22,20 L2,20 Z M8,11 L16,11 L16,17 L8,17 Z M10,11 L10,9 A2,2 0 0 1 14,9 L14,11"
                              Width="18" Height="18" Stretch="Uniform" />
                    </ToggleButton>
                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="6,10" />
                    <Button Style="{StaticResource ToolBarIconBtn}" Click="BtnCameraManager_Click" ToolTip="相机管理">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M2,7 L7,7 L9,4.5 L15,4.5 L17,7 L22,7 L22,19 L2,19 Z M12,9.5 A3.5,3.5 0 1 0 12.01,9.5"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolBarIconBtn}" Click="BtnCommManager_Click" ToolTip="通信管理">
                        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M10,7.5 L7.5,5 A3.9,3.9 0 0 0 2.2,10.3 L4.7,12.8 M14,16.5 L16.5,19 A3.9,3.9 0 0 0 21.8,13.7 L19.3,11.2 M9,15 L15,9"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="6,10" />

                    <TextBlock Text="方案" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="RecipeCombo" Width="200" Height="28" VerticalAlignment="Center" IsEditable="True" Margin="0,0,8,0" />
                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="4,10" />

                    <Button x:Name="BtnRunOnce" Style="{StaticResource ToolBarIconBtn}" Background="#2E5D36" BorderBrush="#3D7A47"
                            Click="BtnRunOnce_Click" IsEnabled="False" ToolTip="单次执行：执行一遍检测流程">
                        <Path Stroke="#E0E0E0" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 M10,8 L16.5,12 L10,16 Z"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="BtnRunContinuous" Style="{StaticResource ToolBarIconBtn}" Background="#1F4A6E" BorderBrush="#2F6A9E" Margin="0,0,8,0"
                            Click="BtnRunContinuous_Click" IsEnabled="False" ToolTip="连续执行：循环执行检测流程（再次点击停止）">
                        <Path x:Name="RunContinuousIcon" Stroke="#E0E0E0" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M21,4 L21,10 L15,10 M19.6,15 A8,8 0 1 1 17.7,6.6 L21,10"
                              Width="18" Height="18" Stretch="Uniform" />
                    </Button>

                    <TextBlock x:Name="FinalVerdictText" Text="{Binding FinalDecision, FallbackValue=待机}" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource MutedTextBrush}" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- ===== 主区: 相机 | 图像 | 参数 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- 左: 状态（相机枚举/连接/预览/触发在「相机管理」弹窗） -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" Margin="0,4,0,4">
                <DockPanel>
                    <GroupBox Header="生产状态" DockPanel.Dock="Top" Margin="6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StateDot" Width="12" Height="12" Fill="#888" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="StateText" Text="{Binding ProductionState, FallbackValue=空闲}" VerticalAlignment="Center" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock x:Name="StateDetailText" Text="{Binding ProductionDetail, FallbackValue=-}" Visibility="Collapsed" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="检测流程" Margin="6">
                        <DockPanel>
                            <Button x:Name="BtnAddNode" Content="+ 添加模块" DockPanel.Dock="Top" Height="26" Margin="2,0,2,6" Click="AddNode_Click" />
                            <TreeView x:Name="NodeTree" Background="Transparent" SelectedItemChanged="NodeTree_SelectedItemChanged" MouseDoubleClick="NodeTree_MouseDoubleClick" />
                        </DockPanel>
                    </GroupBox>
                </DockPanel>
            </Border>
            <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}" />

            <!-- 中: 图像区域（节点执行结果，单一面板 + 可开关的节点缩略图条） -->
            <Border Grid.Column="2" Background="#141414" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" Margin="0,4,0,4">
                <DockPanel>
                    <ScrollViewer x:Name="ThumbStripHost" DockPanel.Dock="Bottom" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="116" Background="#101010">
                        <StackPanel x:Name="ThumbStrip" Orientation="Horizontal" Margin="2" />
                    </ScrollViewer>
                    <Grid x:Name="ImageViewport" ClipToBounds="True"
                          PreviewMouseWheel="ImageViewport_PreviewMouseWheel"
                          PreviewMouseDown="ImageViewport_PreviewMouseDown"
                          PreviewMouseMove="ImageViewport_PreviewMouseMove"
                          PreviewMouseUp="ImageViewport_PreviewMouseUp">
                        <!-- 叠放顺序：图片最底 → ROI 叠加层 → 标题/缩略图按钮置顶（否则结果图会盖住按钮导致点击失效） -->
                        <Image x:Name="ResultImage" Stretch="Uniform" Margin="2"
                               RenderTransformOrigin="0.5,0.5" />
                        <Canvas x:Name="RoiCanvas" Margin="2" Background="Transparent" IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5"
                                MouseLeftButtonDown="RoiCanvas_MouseLeftButtonDown"
                                MouseMove="RoiCanvas_MouseMove"
                                MouseLeftButtonUp="RoiCanvas_MouseLeftButtonUp"
                                MouseRightButtonUp="RoiCanvas_MouseRightButtonUp" />
                        <TextBlock x:Name="ResultCaption" Text="执行结果" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0">
                            <Button Style="{StaticResource ToolBarIconBtn}" Click="BtnZoomIn_Click" ToolTip="放大图像">
                                <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21 M10,6 L10,14 M6,10 L14,10"
                                      Width="18" Height="18" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource ToolBarIconBtn}" Click="BtnZoomOut_Click" ToolTip="缩小图像">
                                <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21 M6,10 L14,10"
                                      Width="18" Height="18" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource ToolBarIconBtn}" Click="BtnImageFit_Click" ToolTip="适应窗口">
                                <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M3,8 L3,3 L8,3 M16,3 L21,3 L21,8 M21,16 L21,21 L16,21 M8,21 L3,21 L3,16"
                                      Width="18" Height="18" Stretch="Uniform" />
                            </Button>
                            <ToggleButton x:Name="BtnThumbToggle" Width="34" Height="30" Padding="0" Margin="2,0,0,0"
                                          Click="BtnThumbToggle_Click" ToolTip="显示/隐藏节点缩略图">
                                <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M3,5 L21,5 L21,19 L3,19 Z M6,15 L10,11 L13,14 L16,11 L19,15"
                                      Width="18" Height="18" Stretch="Uniform" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
            <Rectangle Grid.Column="3" Fill="{StaticResource BorderBrush}" />

            <!-- 右: 节点状态 | 模块结果（相机配置在「相机管理」弹窗；IO 输出配置在「相机IO通信」节点弹窗） -->
            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" Margin="0,4,0,4">
                <TabControl Margin="0,6,0,0">
                    <TabItem Header="节点状态">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="InspectorPanel" Margin="8" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="模块结果">
                        <Grid Margin="8,4,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ModuleResultTitle" Text="模块结果（在左侧流程选择节点）" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,2,0,6" />
                            <local:ModuleResultView x:Name="InspectorResultView" Grid.Row="1" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ===== 底部: 结果 + 日志 ===== -->
        <Grid Grid.Row="2" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="检测结果" Margin="2">
                <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding ProcessedAt}" Width="150" />
                        <DataGridTextColumn Header="图片" Binding="{Binding Image}" Width="200" />
                        <DataGridTextColumn Header="判定" Binding="{Binding Decision}" Width="80" />
                        <DataGridTextColumn Header="分数" Binding="{Binding Score}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
            <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}" />
            <GroupBox Grid.Column="2" Header="日志" Margin="2">
                <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
            </GroupBox>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <StatusBar Grid.Row="3">
            <StatusBarItem><TextBlock x:Name="StatusCamera" Text="{Binding CameraStatus, FallbackValue=相机: 未连接}" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusTrigger" Text="{Binding TriggerStatus, FallbackValue=触发: -}" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusFps" Text="{Binding FpsStatus, FallbackValue=FPS: -}" /></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
