<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>SpeakerVisionInspection</RootNamespace>
    <AssemblyName>SpeakerVisionInspection</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.1" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!-- 相机控制托管程序集：复用 HikCameraManager 的 sdk\managed（随仓库分发，无需环境变量） -->
  <ItemGroup Condition="Exists('..\HikCameraManager\sdk\managed\MvCameraControl.Net.dll')">
    <Reference Include="MvCameraControl.Net">
      <HintPath>..\HikCameraManager\sdk\managed\MvCameraControl.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 相机原生运行时（MvCameraControl.dll 等 MVS Runtime）随构建复制到输出目录 -->
  <ItemGroup>
    <None Include="..\HikCameraManager\sdk\native\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SpeakerVisionInspection.Tests\**" />
    <EmbeddedResource Remove="SpeakerVisionInspection.Tests\**" />
    <None Remove="SpeakerVisionInspection.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpeakerVisionInspection.Tests" />
  </ItemGroup>

</Project>
