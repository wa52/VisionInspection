<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>VisionInspection</RootNamespace>
    <AssemblyName>VisionInspection</AssemblyName>
    <ApplicationIcon>Assets\VisionInspection.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.1" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!-- 鐩告満鎺у埗鎵樼绋嬪簭闆嗭細澶嶇敤 HikCameraManager 鐨?sdk\managed锛堥殢浠撳簱鍒嗗彂锛屾棤闇€鐜鍙橀噺锛?-->
  <ItemGroup Condition="Exists('..\HikCameraManager\sdk\managed\MvCameraControl.Net.dll')">
    <Reference Include="MvCameraControl.Net">
      <HintPath>..\HikCameraManager\sdk\managed\MvCameraControl.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 鐩告満鍘熺敓杩愯鏃讹紙MvCameraControl.dll 绛?MVS Runtime锛夐殢鏋勫缓澶嶅埗鍒拌緭鍑虹洰褰?-->
  <ItemGroup>
    <None Include="..\HikCameraManager\sdk\native\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="VisionInspection.Tests\**" />
    <EmbeddedResource Remove="VisionInspection.Tests\**" />
    <None Remove="VisionInspection.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VisionInspection.Tests" />
  </ItemGroup>

</Project>

